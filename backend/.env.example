# URL de conexão do PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://usuario:senha@localhost:5432/argos?schema=public"

# Porta em que o backend HTTP nativo (server.ts) escuta
PORT=3001

# Origem permitida pelo CORS (frontend Vite em dev)
CORS_ORIGIN="http://localhost:5173"

# Minutos de validade do cache de clima gravado na tabela WeatherData
WEATHER_CACHE_MINUTES=15
