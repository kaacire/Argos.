generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WeatherData {
  id            String   @id @default(cuid())
  latitude      Float
  longitude     Float
  temperature   Float
  condition     String
  humidity      Float
  windSpeed     Float
  city          String
  state         String
  source        String   @default("open-meteo")
  fetchedAt     DateTime @default(now())
  precipitation Float    @default(0)
  forecast      Json?

  @@index([latitude, longitude, fetchedAt])
}

model WeatherHistoryCache {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  period    String
  points    Json
  source    String   @default("open-meteo")
  fetchedAt DateTime @default(now())

  @@unique([latitude, longitude, period])
}
